# Copy this file to config/robot.env and adapt it for the target robot.
# Do not add spaces around '='.
ROS_DISTRO=humble
ROS_DOMAIN_ID=0

SLAM_ENVIRONMENT=outdoor
SLAM_DISPLAY_MODE=original
SLAM_MAP_FRAME=map
SLAM_ODOM_FRAME=odom
SLAM_BASE_FRAME=livox_frame
SLAM_OUTPUT_DIRECTORY=maps
SLAM_OUTPUT_SEQUENCE=robot_mapping

SLAM_START_DRIVER=false
SLAM_DRIVER_PACKAGE=livox_ros_driver2
SLAM_DRIVER_LAUNCH_FILE=msg_MID360_launch.py
SLAM_START_RVIZ=false
SLAM_RECORD_DIAGNOSTICS=true
